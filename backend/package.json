{
  "name": "recruiter-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd backend && bun run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
